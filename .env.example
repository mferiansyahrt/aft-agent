# Hermes AFT - salin ke .env lalu isi.

# Urutan model (fallback), pisahkan koma: openai | gemini | openai_like
# Contoh: LLM_PROVIDER=openai,gemini  -> coba OpenAI dulu, kalau gagal/tidak tersedia pakai Gemini
LLM_PROVIDER=openai

# OpenAI (Responses API)
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-5.6-luna
OPENAI_REASONING_EFFORT=

# Gemini native (agno.models.google.Gemini)
#  a) Gemini API: isi GOOGLE_API_KEY (dari Google AI Studio)
#  b) Vertex AI : GOOGLE_VERTEXAI=true + GOOGLE_CLOUD_PROJECT + GOOGLE_CLOUD_LOCATION
#     (login: gcloud auth application-default login). Region asia-southeast2 = Jakarta.
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-3.7-flash
GEMINI_THINKING_BUDGET=
GOOGLE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast2

# OpenAI-compatible (LLM internal, atau Gemini lewat endpoint OpenAI-compat):
#   LLM_PROVIDER=openai_like
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=<GOOGLE_API_KEY>
#   LLM_MODEL_NAME=gemini-3.7-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=

# Database
AFT_DB_PATH=source/database/aft.sqlite
RUNS_DB_PATH=source/database/runs.sqlite

# Agent
AGENT_TOOL_CALL_LIMIT=20
AGENT_SESSION_BUDGET_S=300
VALIDATOR_MAX_RETRIES=2
